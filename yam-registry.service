[Unit]
Description=YAM package registry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yam-registry
Group=yam-registry
EnvironmentFile=/etc/yam-registry.env
ExecStart=/opt/yam-registry/bin/yam-registry --data-dir /var/lib/yam-registry
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yam-registry

[Install]
WantedBy=multi-user.target
